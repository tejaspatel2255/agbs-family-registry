# ============================================================
# AGBS Family Registry System — .gitignore
# ============================================================

# -----------------------------------------------
# ⚠️ CREDENTIALS & SECRETS — NEVER COMMIT THESE
# -----------------------------------------------
.env
.env.*
*.env
*.env.*
*.pem
*.key
*.secret
*.secrets
*.credentials
google-services.json
GoogleService-Info.plist
key.properties
keystore/
*.jks
*.keystore

# Supabase local secrets
supabase/.temp/
supabase/.env
supabase/.env.*
supabase/functions/*/.env

# -----------------------------------------------
# Flutter / Dart / Pub
# -----------------------------------------------
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# -----------------------------------------------
# Android Build Artifacts
# -----------------------------------------------
/android/app/debug/
/android/app/profile/
/android/app/release/
/android/.gradle/
/android/local.properties
/android/captures/

# -----------------------------------------------
# iOS Build Artifacts
# -----------------------------------------------
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec

# -----------------------------------------------
# macOS / Windows / Linux Build Artifacts
# -----------------------------------------------
/windows/flutter/ephemeral/
/macos/Flutter/ephemeral/
/linux/flutter/ephemeral/

# -----------------------------------------------
# Web Build Artifacts
# -----------------------------------------------
/web/flutter_service_worker.js

# -----------------------------------------------
# IDEs & Editors
# -----------------------------------------------
*.iml
*.ipr
*.iws
.idea/
.kotlin/
android/.kotlin/
.vscode/
*.swp
.atom/

# -----------------------------------------------
# OS & Misc
# -----------------------------------------------
.DS_Store
Thumbs.db
*.class
*.log
*.pyc
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# -----------------------------------------------
# Obfuscation / Symbolication
# -----------------------------------------------
app.*.symbols
app.*.map.json
